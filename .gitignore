# Backups created by the install scripts
*.bak

# macOS
.DS_Store

# Windows
Thumbs.db

# Temp work dirs (shouldn't be here, but just in case)
/tmp/

# Agent worktrees and machine-local harness settings
/.claude/worktrees/
/.claude/settings.local.json

# Python bytecode from scripts/
__pycache__/

# Bundle artifacts copied out of the asar for manual inspection.
# update-ui.sh extracts its own copies to /tmp/claude-ui-work; nothing here reads these.
/index.js
/mainView.js
/index.chunk-*.js
